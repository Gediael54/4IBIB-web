{
  "name": "4ibib-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:site",
    "dev:site": "npm run dev --workspace @4ibib/site",
    "dev:admin": "npm run dev --workspace @4ibib/admin",
    "build": "npm run build --workspace @4ibib/site && npm run build --workspace @4ibib/admin && node scripts/compose-dist.mjs",
    "test": "vitest run --coverage",
    "typecheck": "npm run typecheck --workspace @4ibib/core && npm run typecheck --workspace @4ibib/mock && npm run typecheck --workspace @4ibib/supabase && npm run typecheck --workspace @4ibib/site && npm run typecheck --workspace @4ibib/admin",
    "preview:site": "npm run preview --workspace @4ibib/site",
    "preview:admin": "npm run preview --workspace @4ibib/admin"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
