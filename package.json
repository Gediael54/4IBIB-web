{
  "name": "4ibib-web",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:site",
    "dev:site": "npm run dev --workspace @4ibib/site",
    "dev:admin": "npm run dev --workspace @4ibib/admin",
    "build": "npm run build --workspace @4ibib/site && npm run build --workspace @4ibib/admin && node scripts/compose-dist.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "typecheck": "npm run typecheck --workspace @4ibib/core && npm run typecheck --workspace @4ibib/supabase && npm run typecheck --workspace @4ibib/db && npm run typecheck --workspace @4ibib/site && npm run typecheck --workspace @4ibib/admin",
    "preview:site": "npm run preview --workspace @4ibib/site",
    "preview:admin": "npm run preview --workspace @4ibib/admin",
    "prepare": "husky",
    "seed:schedule": "node scripts/seed-from-xlsx.mjs",
    "db:types": "npx supabase gen types typescript --linked --schema public > packages/db/types.ts",
    "analyze": "ANALYZE=true npm run build",
    "license-check": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow 'MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;CC0-1.0;CC-BY-4.0;Unlicense;0BSD;MIT-0;BlueOak-1.0.0;Python-2.0'"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "lint-staged": "^16.4.0",
    "pg": "^8.20.0",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "semantic-release": "^25.0.3",
    "sharp": "^0.34.5",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.10",
    "vitest": "^3.0.0",
    "vitest-axe": "^0.1.0",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "^10.51.0",
    "@supabase/supabase-js": "^2.105.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "valibot": "^1.3.1"
  }
}
